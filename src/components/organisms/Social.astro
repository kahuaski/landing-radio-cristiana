---
import Icon from "../atoms/Icon.astro";
import { SOCIAL_LINKS } from "../../config/social";
---

<section
	id="redes"
	aria-labelledby="redes-title"
	class="scroll-mt-20 bg-primary-container py-16 text-inverse-on-surface md:py-24 dark:bg-navy"
>
	<div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
		<div class="flex flex-col items-start gap-5">
			<span
				class="flex h-14 w-14 items-center justify-center rounded-lg bg-dawn-bright/15 text-dawn-bright"
			>
				<Icon name="globe" class="h-7 w-7" />
			</span>
			<h2
				id="redes-title"
				class="font-display text-headline-lg font-bold tracking-tight text-white"
			>
				Encuéntranos en nuestras redes sociales
			</h2>
			<p class="max-w-xl text-body-lg text-inverse-on-surface/75">
				Síguenos en Facebook, TikTok, YouTube y Telegram para no perderte
				nuestras alabanzas, predicaciones y transmisiones en vivo.
			</p>
			<button
				type="button"
				data-playlist-open
				class="inline-flex items-center gap-2 rounded-md bg-dawn px-5 py-3 text-label-lg font-semibold text-white transition-colors hover:bg-dawn-strong focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-dawn-bright focus-visible:ring-offset-2 focus-visible:ring-offset-primary-container"
			>
				<Icon name="play" class="h-5 w-5" />
				Escúchanos ahora
			</button>
		</div>

		<ul class="grid gap-4 sm:grid-cols-2">
			{
				SOCIAL_LINKS.map((social) => (
					<li>
						<a
							href={social.url}
							target="_blank"
							rel="noopener noreferrer me"
							aria-label={`${social.label} de Radio Ministerial Mushuk Kawsay`}
							class="group flex h-full items-center gap-4 rounded-lg border border-white/10 bg-white/5 p-5 backdrop-blur transition-colors hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-dawn-bright"
						>
							<span
								class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-white/10 transition-transform duration-300 group-hover:scale-110"
								style={`color: ${social.color}`}
							>
								<Icon name={social.red} class="h-6 w-6" />
							</span>
							<div class="min-w-0">
								<p class="font-display text-title-md font-semibold text-white">
									{social.label}
								</p>
								<p class="truncate text-body-sm text-inverse-on-surface/70">
									{social.handle}
								</p>
							</div>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>
