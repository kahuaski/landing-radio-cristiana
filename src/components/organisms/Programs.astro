---
import Button from "../atoms/Button.astro";
import ProgramCard from "../molecules/ProgramCard.astro";

const programs = [
	{
		title: "Maná de la Mañana",
		host: "Pastor José Ramírez",
		schedule: "Lun a Vie · 6:00 – 9:00",
		time: "3 h",
		tag: "Predicación",
		description:
			"Arranca el día con devocional, oración y la Palabra para caminar con fuerza.",
	},
	{
		title: "Alabanza sin Límites",
		host: "Laura Mendoza",
		schedule: "Sáb · 10:00 – 13:00",
		time: "3 h",
		tag: "Música",
		description:
			"Lo mejor de la alabanza contemporánea y adoración en español para renovarte.",
	},
	{
		title: "Familia en Cristo",
		host: "Carlos y Ana Ruiz",
		schedule: "Mié · 20:00 – 21:30",
		time: "1 h 30",
		tag: "Familia",
		description:
			"Consejería práctica, testimonios y herramientas para fortalecer el hogar.",
	},
	{
		title: "Juventud en Acción",
		host: "Equipo juvenil",
		schedule: "Vie · 19:00 – 21:00",
		time: "2 h",
		tag: "Juventud",
		description:
			"Música, entrevistas y retos de fe pensados para la nueva generación.",
	},
	{
		title: "Hora de la Profecía",
		host: "Obispo Daniel Ortega",
		schedule: "Dom · 18:00 – 20:00",
		time: "2 h",
		tag: "Profecía",
		description:
			"Mensajes de dirección espiritual, intercesión y avisos para la iglesia.",
	},
	{
		title: "Coros y Cantos",
		host: "Selección musical",
		schedule: "Todos los días · 14:00",
		time: "2 h",
		tag: "Música",
		description:
			"Coros, himnos y cantos que acompañan tu tarde con himnos inolvidables.",
	},
];
---

<section aria-labelledby="programas-title" class="scroll-mt-20 py-16 md:py-24">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="max-w-2xl">
			<p class="text-label-broadcast uppercase text-dawn dark:text-dawn-bright">
				Programación
			</p>
			<h2
				id="programas-title"
				class="mt-2 font-display text-headline-lg font-bold tracking-tight text-on-surface dark:text-white"
			>
				Programas para cada momento de tu día
			</h2>
			<p class="mt-4 text-body-lg text-on-surface-variant dark:text-inverse-on-surface/80">
				Predicación, música y contenidos para toda la familia, con horarios que se
				adaptan a tu rutina.
			</p>
		</div>

		<div class="mt-10 grid gap-gutter sm:grid-cols-2 lg:grid-cols-3">
			{programs.map((program) => <ProgramCard {...program} />)}
		</div>

		<div class="mt-10 flex justify-center">
			<Button href="/programas" variant="ghost">Ver toda la programación</Button>
		</div>
	</div>
</section>
