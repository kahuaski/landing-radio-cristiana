---
import Button from "../atoms/Button.astro";
import Icon from "../atoms/Icon.astro";
import NavItem from "../molecules/NavItem.astro";

const links = [
	{ href: "/", label: "Inicio", active: true },
	{ href: "/programas", label: "Programas" },
	{ href: "/nosotros", label: "Nosotros" },
	{ href: "/contacto", label: "Contacto" },
];
---

<header
	class="sticky top-0 z-40 border-b border-outline-variant/60 bg-surface/85 backdrop-blur-md dark:border-white/10 dark:bg-navy/85"
>
	<nav
		aria-label="Navegación principal"
		class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-gutter px-4 sm:px-6 lg:px-8"
	>
		<a
			href="/"
			class="flex items-center gap-2.5 rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-dawn-bright"
		>
			<span
				class="flex h-9 w-9 items-center justify-center rounded-md bg-navy text-dawn-bright dark:bg-surface-container-high dark:text-dawn"
			>
				<Icon name="radio" class="h-5 w-5" />
			</span>
			<span
				class="hidden font-display text-title-md font-bold tracking-tight text-on-surface sm:inline dark:text-white"
			>
				Radio Ministerial Mushuk Kawsay
			</span>
			<span
				class="font-display text-title-md font-bold tracking-tight text-on-surface sm:hidden dark:text-white"
			>
				Mushuk Kawsay
			</span>
		</a>

		<div class="hidden items-center gap-1 md:flex">
			{links.map((link) => <NavItem href={link.href} label={link.label} active={link.active} />)}
		</div>

		<div class="flex items-center gap-2">
			<button
				type="button"
				data-theme-toggle
				aria-label="Cambiar entre modo claro y oscuro"
				class="flex h-9 w-9 items-center justify-center rounded-md text-on-surface-variant hover:bg-surface-container-low dark:text-inverse-on-surface/70 dark:hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-dawn-bright"
			>
				<Icon name="sun" class="h-5 w-5 dark:hidden" />
				<Icon name="moon" class="hidden h-5 w-5 dark:block" />
			</button>

			<Button variant="primary" class="hidden sm:inline-flex" data-playlist-open>
				<Icon name="play" class="h-4 w-4" />
				Escuchar en vivo
			</Button>

			<details class="group relative md:hidden">
				<summary
					class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-md text-on-surface-variant hover:bg-surface-container-low dark:text-inverse-on-surface/70 dark:hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-dawn-bright [&::-webkit-details-marker]:hidden"
					aria-label="Abrir menú"
				>
					<Icon name="menu" class="h-5 w-5" />
				</summary>
				<div
					class="absolute right-0 top-11 w-56 rounded-lg border border-outline-variant bg-surface-container-lowest p-2 shadow-elevated dark:border-white/10 dark:bg-navy-soft"
				>
					{
						links.map((link) => (
							<a
								href={link.href}
								aria-current={link.active ? "page" : undefined}
								class="block rounded-md px-3 py-2 text-label-lg font-medium text-on-surface-variant hover:bg-surface-container-low dark:text-inverse-on-surface dark:hover:bg-white/10"
							>
								{link.label}
							</a>
						))
					}
					<button
						type="button"
						data-playlist-open
						class="mt-1 block w-full rounded-md bg-dawn px-3 py-2 text-center text-label-lg font-semibold text-white hover:bg-dawn-strong"
					>
						Escuchar en vivo
					</button>
				</div>
			</details>
		</div>
	</nav>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
	toggle?.addEventListener("click", () => {
		const isDark = document.documentElement.classList.toggle("dark");
		localStorage.theme = isDark ? "dark" : "light";
	});
</script>
