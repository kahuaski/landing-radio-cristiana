---
import { PLAYLIST, getPlaylistEmbedUrl } from "../../config/playlist";

const embedUrl = getPlaylistEmbedUrl();
---

<dialog
	data-playlist-modal
	aria-label={`Reproductor: ${PLAYLIST.title}`}
	class="m-auto w-[min(92vw,56rem)] rounded-xl border border-white/10 bg-navy p-0 text-inverse-on-surface shadow-player backdrop:bg-navy/70 backdrop:backdrop-blur-sm"
>
	<div class="flex items-center justify-between gap-4 border-b border-white/10 px-5 py-4">
		<div class="flex min-w-0 items-center gap-3">
			<span
				class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-dawn text-white shadow-aura"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="currentColor"
					aria-hidden="true"
					class="h-5 w-5"
				>
					<path d="M8 5.14v14l11-7-11-7z"></path>
				</svg>
			</span>
			<div class="min-w-0">
				<p class="text-label-broadcast uppercase text-dawn-bright">Playlist</p>
				<p class="truncate font-display text-title-md text-white">
					{PLAYLIST.title}
				</p>
			</div>
		</div>
		<button
			type="button"
			data-playlist-close
			aria-label="Cerrar reproductor"
			class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-inverse-on-surface/70 transition-colors hover:bg-white/10 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-dawn-bright"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.75"
				stroke-linecap="round"
				aria-hidden="true"
				class="h-5 w-5"
			>
				<path d="M6 6l12 12M18 6 6 18"></path>
			</svg>
		</button>
	</div>

	<div class="aspect-video w-full bg-black">
		<iframe
			data-playlist-frame
			data-src={embedUrl}
			title={`Playlist de YouTube: ${PLAYLIST.title}`}
			allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
			allowfullscreen
			referrerpolicy="strict-origin-when-cross-origin"
			class="h-full w-full border-0"></iframe>
	</div>

	<p class="px-5 py-3 text-body-sm text-inverse-on-surface/60">
		Selección musical de {PLAYLIST.subtitle.toLowerCase()} reproducida desde
		YouTube.
	</p>
</dialog>

<script>
	const modal = document.querySelector<HTMLDialogElement>("[data-playlist-modal]");
	const frame = modal?.querySelector<HTMLIFrameElement>("[data-playlist-frame]");
	const closeBtn = modal?.querySelector<HTMLButtonElement>("[data-playlist-close]");
	const triggers = document.querySelectorAll<HTMLElement>("[data-playlist-open]");

	const open = () => {
		if (!modal || !frame) return;
		const src = frame.dataset.src;
		if (src && !frame.getAttribute("src")) frame.setAttribute("src", src);
		if (!modal.open) modal.showModal();
	};

	const close = () => {
		if (!modal) return;
		modal.close();
		// Detiene la reproducción al cerrar.
		frame?.removeAttribute("src");
	};

	triggers.forEach((trigger) => trigger.addEventListener("click", open));
	closeBtn?.addEventListener("click", close);

	// Cerrar al hacer clic fuera del diálogo.
	modal?.addEventListener("click", (event) => {
		if (event.target === modal) close();
	});

	// El cierre con ESC limpia el iframe.
	modal?.addEventListener("close", () => frame?.removeAttribute("src"));
</script>
