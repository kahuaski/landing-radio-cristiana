---
import Button from "../atoms/Button.astro";
import Icon from "../atoms/Icon.astro";

const pillars = [
	{
		icon: "heart" as const,
		title: "Fe que transforma",
		description: "Mensajes y alabanzas que edifican tu vida espiritual cada día.",
	},
	{
		icon: "users" as const,
		title: "Comunidad",
		description: "Millones de oyentes unidos en oración, adoración y servicio.",
	},
	{
		icon: "mic" as const,
		title: "Contenido de calidad",
		description: "Programas producidos con profesionales y pastores experimentados.",
	},
];

const servicios = [
	"Eventos sociales",
	"Eventos eclesiásticos",
	"Eventos culturales",
	"Sonidos",
	"Transmisión en vivo",
];

const contacto = [
	{
		icon: "whatsapp" as const,
		label: "0967 198 899",
		href: "https://wa.me/593967198899",
		aria: "Escribir por WhatsApp al 0967 198 899",
		class:
			"bg-[#25D366] text-white hover:bg-[#128C7E] focus-visible:ring-[#25D366]",
		externo: true,
	},
	{
		icon: "mail" as const,
		label: "waldo.yacelga70@gmail.com",
		href: "mailto:waldo.yacelga70@gmail.com",
		aria: "Enviar un correo a waldo.yacelga70@gmail.com",
		class:
			"border border-white/15 bg-white/10 text-inverse-on-surface hover:bg-white/20 focus-visible:ring-dawn-bright",
		externo: false,
	},
	{
		icon: "facebook" as const,
		label: "Gerge waldo yacelga",
		href: "https://www.facebook.com/search/top?q=Gerge%20waldo%20yacelga",
		aria: "Buscar a Gerge Waldo Yacelga en Facebook",
		class: "bg-[#1877f2] text-white hover:bg-[#166fe0] focus-visible:ring-[#1877f2]",
		externo: true,
	},
];
---

<section
	id="nosotros"
	aria-labelledby="nosotros-title"
	class="scroll-mt-20 py-16 md:py-24"
>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid items-center gap-12 lg:grid-cols-2">
			<div
				class="relative aspect-square w-full overflow-hidden rounded-xl bg-gradient-to-br from-navy via-primary-container to-secondary dark:to-navy shadow-player"
			>
				<div
					class="absolute inset-0 flex flex-col items-center justify-center gap-4 p-8 text-center text-white"
				>
					<span
						class="flex h-20 w-20 items-center justify-center rounded-full bg-white/10 text-dawn-bright shadow-aura"
					>
						<Icon name="radio" class="h-10 w-10" />
					</span>
					<p class="font-display text-headline-md font-bold">Desde 2011</p>
					<p class="max-w-xs text-body-md text-white/75">
						Llevando esperanza a hogares, hospitales y carreteras de todo el país.
					</p>
				</div>
			</div>

			<div class="flex flex-col items-start gap-6">
				<p class="text-label-broadcast uppercase text-dawn dark:text-dawn-bright">
					Nosotros
				</p>
				<h2
					id="nosotros-title"
					class="font-display text-headline-lg font-bold tracking-tight text-on-surface dark:text-white"
				>
					Una radio con propósito
				</h2>
				<p class="text-body-lg text-on-surface-variant dark:text-inverse-on-surface/80">
					Radio Ministerial Mushuk Kawsay nació con una misión sencilla: usar los
					medios para que Cristo llegue a cada hogar. Transmitimos desde nuestro
					estudio con un equipo comprometido con la excelencia y la Palabra de Dios.
				</p>

				<ul class="flex w-full flex-col gap-4">
					{
						pillars.map((pillar) => (
							<li class="flex gap-4 rounded-lg border border-outline-variant bg-surface-container-lowest p-4 shadow-card dark:border-white/10 dark:bg-white/5">
								<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-md bg-secondary-container/15 text-dawn dark:text-dawn-bright">
									<Icon name={pillar.icon} class="h-6 w-6" />
								</span>
								<div>
									<p class="font-display text-title-md text-on-surface dark:text-white">
										{pillar.title}
									</p>
									<p class="text-body-sm text-on-surface-variant dark:text-inverse-on-surface/70">
										{pillar.description}
									</p>
								</div>
							</li>
						))
					}
				</ul>

				<Button href="/nosotros" variant="ghost">Conoce nuestra historia →</Button>
			</div>
		</div>

		<article
			aria-labelledby="locutor-title"
			class="relative mt-14 overflow-hidden rounded-2xl border border-white/10 bg-gradient-to-br from-navy via-navy-soft to-primary-container p-6 text-inverse-on-surface shadow-player sm:p-8"
		>
			<div
				class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-dawn-bright/20 blur-3xl"
				aria-hidden="true"
			>
			</div>
			<div
				class="pointer-events-none absolute -bottom-20 -left-16 h-56 w-56 rounded-full bg-dawn/15 blur-3xl"
				aria-hidden="true"
			>
			</div>

			<div
				class="relative flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-8"
			>
				<div class="relative w-full shrink-0 sm:w-56">
					<img
						src="/locutor.jpeg"
						alt="Oswaldo Yacelga, animador y locutor de Radio Ministerial Mushuk Kawsay"
						width="480"
						height="480"
						loading="lazy"
						decoding="async"
						class="aspect-[4/3] w-full rounded-xl object-cover object-top ring-4 ring-dawn-bright/30 sm:aspect-square"
					/>
					<span
						class="absolute bottom-3 left-3 rounded-full bg-dawn-bright px-3 py-1 text-label-broadcast uppercase text-navy shadow-aura"
					>
						Animador / Locutor
					</span>
				</div>

				<div class="min-w-0 flex-1">
					<p class="text-label-broadcast uppercase text-dawn-bright">
						Conoce a nuestra voz
					</p>
					<h3
						id="locutor-title"
						class="mt-1 font-display text-headline-md font-bold tracking-tight text-white"
					>
						Oswaldo Yacelga
					</h3>
					<p class="mt-3 max-w-2xl text-body-md text-inverse-on-surface/75">
						Animador y locutor para eventos sociales, eclesiásticos y culturales,
						sonidos y transmisión en vivo. Una conducción cercana y profesional
						para acompañar cada momento especial.
					</p>

					<ul class="mt-4 flex flex-wrap gap-2">
						{
							servicios.map((servicio) => (
								<li class="inline-flex items-center gap-1.5 rounded-full border border-white/15 bg-white/10 px-3 py-1 text-label-md uppercase text-inverse-on-surface/90">
									<Icon name="sparkles" class="h-3.5 w-3.5 text-dawn-bright" />
									{servicio}
								</li>
							))
						}
					</ul>

					<div class="mt-6 flex flex-wrap gap-3">
						{
							contacto.map((item) => (
								<a
									href={item.href}
									target={item.externo ? "_blank" : undefined}
									rel={item.externo ? "noopener noreferrer" : undefined}
									aria-label={item.aria}
									class={`inline-flex max-w-full items-center gap-2 rounded-lg px-4 py-2.5 text-label-lg font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-navy ${item.class}`}
								>
									<Icon name={item.icon} class="h-5 w-5 shrink-0" />
									<span class="truncate">{item.label}</span>
								</a>
							))
						}
					</div>
				</div>
			</div>
		</article>
	</div>
</section>
