---
import Button from "../atoms/Button.astro";
import Icon from "../atoms/Icon.astro";
import VideoEmbed from "../molecules/VideoEmbed.astro";
import { MEDIA, getEmbedUrl } from "../../config/media";

const stats = [
	{ icon: "users" as const, value: "50K+", label: "Oyentes mensuales" },
	{ icon: "mic" as const, value: "12", label: "Programas propios" },
	{ icon: "clock" as const, value: "24/7", label: "Transmisión en vivo" },
	{ icon: "heart" as const, value: "15", label: "Años bendiciendo" },
];

const videosEmbed = getEmbedUrl(MEDIA.videos.url);
---

<section class="relative overflow-hidden" aria-labelledby="hero-title">
	<div
		class="absolute inset-0 bg-gradient-to-br from-surface via-surface-container-low to-secondary-container/10 dark:from-navy dark:via-navy dark:to-primary-container"
		aria-hidden="true"
	>
	</div>
	<div
		class="pointer-events-none absolute -right-24 -top-24 h-96 w-96 rounded-full bg-dawn-bright/20 blur-3xl"
		aria-hidden="true"
	>
	</div>
	<div
		class="relative mx-auto grid max-w-7xl gap-12 px-4 py-16 sm:px-6 md:py-24 lg:grid-cols-2 lg:px-8"
	>
		<div class="flex flex-col items-start gap-6">

			<h1
				id="hero-title"
				class="font-display text-headline-xl font-extrabold tracking-tight text-on-surface dark:text-white"
			>
				Radio  Ministerial Mushuk Kawsay, tu canal de  
				<span class="text-dawn dark:text-dawn-bright"> Fe</span>
				
			</h1>
			<img
				src="/logo1.jpeg"
				alt="Logo de Radio Ministerial Mushuk Kawsay"
				width="800"
				height="800"
				loading="eager"
				decoding="async"
				class="h-full w-auto object-contain sm:h-full"
			/>
			<p class="max-w-xl text-body-lg text-on-surface-variant dark:text-inverse-on-surface/80">
				Mira que te mando que te esfuerces y seas valiente; no temas ni desmayes, porque Jehová tu Dios estará contigo en donde quiera que vayas. (Josué 1:9, RVR1960)
			</p>
			<dl class="grid w-full grid-cols-2 gap-4 pt-4 sm:grid-cols-4 lg:hidden">
				{
					stats.map((stat) => (
						<div class="rounded-lg border border-outline-variant bg-surface-container-lowest p-4 text-center shadow-card dark:border-white/10 dark:bg-white/5">
							<dt class="sr-only">{stat.label}</dt>
							<dd>
								<p class="font-display text-headline-md text-on-surface dark:text-white">
									{stat.value}
								</p>
								<p class="mt-1 text-label-md uppercase text-on-surface-variant dark:text-inverse-on-surface/70">
									{stat.label}
								</p>
							</dd>
						</div>
					))
				}
			</dl>
		</div>

		<div class="hidden flex-col gap-4 lg:flex">
			<div
				id="player"
				class="scroll-mt-24 rounded-xl bg-navy p-4 text-inverse-on-surface shadow-player dark:border dark:border-white/10"
			>
				<div class="mb-3 flex items-center justify-between gap-3 px-1">
					<div class="min-w-0">
						<p class="text-label-broadcast uppercase text-dawn-bright">
							{MEDIA.videos.label}
						</p>
						<p class="truncate font-display text-title-md text-white">
							{MEDIA.videos.title}
						</p>
					</div>
					<button
						type="button"
						data-playlist-open
						data-media-target="videos"
						class="shrink-0 rounded-full border border-white/15 px-3 py-1.5 text-label-broadcast uppercase text-inverse-on-surface/80 transition-colors hover:bg-white/10 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-dawn-bright"
					>
						Pantalla completa
					</button>
				</div>

				<VideoEmbed
					src={videosEmbed}
					poster="/og-image.png"
					title={`Videos: ${MEDIA.videos.title}`}
					label="Reproducir videos"
				/>
			</div>
		</div>
	</div>
</section>
