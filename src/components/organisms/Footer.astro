---
import Icon from "../atoms/Icon.astro";

const year = new Date().getFullYear();

const columns = [
	{
		title: "Radio",
		links: [
			{ label: "Programas", href: "/programas" },
			{ label: "Frecuencias", href: "/#escuchanos" },
			{ label: "En vivo", href: "/#player" },
		],
	},
	{
		title: "Institución",
		links: [
			{ label: "Nosotros", href: "/nosotros" },
			{ label: "Contacto", href: "/contacto" },
			{ label: "Únete al equipo", href: "/contacto" },
		],
	},
	{
		title: "Legal",
		links: [
			{ label: "Aviso de privacidad", href: "/privacidad" },
			{ label: "Términos de uso", href: "/terminos" },
		],
	},
];
---

<footer class="border-t border-outline-variant/60 bg-surface-container-low dark:border-white/10 dark:bg-navy">
	<div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
		<div class="grid gap-10 md:grid-cols-4">
			<div class="md:col-span-1">
				<a href="/" class="flex items-center gap-2.5">
					<span
						class="flex h-9 w-9 items-center justify-center rounded-md bg-navy text-dawn-bright dark:bg-surface-container-high dark:text-dawn"
					>
						<Icon name="radio" class="h-5 w-5" />
					</span>
					<span class="font-display text-title-md font-bold text-on-surface dark:text-white">
						Radio Ministerial Mushuk Kawsay
					</span>
				</a>
				<p class="mt-4 text-body-sm text-on-surface-variant dark:text-inverse-on-surface/70">
					Música, predicación y esperanza las 24 horas para ti y tu familia.
				</p>
			</div>

			{
				columns.map((column) => (
					<nav aria-label={column.title}>
						<h3 class="text-label-md uppercase text-on-surface dark:text-white">
							{column.title}
						</h3>
						<ul class="mt-4 space-y-2">
							{column.links.map((link) => (
								<li>
									<a
										href={link.href}
										class="rounded text-body-sm text-on-surface-variant hover:text-dawn dark:text-inverse-on-surface/70 dark:hover:text-dawn-bright focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-dawn-bright"
									>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				))
			}
		</div>

		<div
			class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-outline-variant/60 pt-6 text-body-sm text-on-surface-variant dark:border-white/10 dark:text-inverse-on-surface/60 sm:flex-row"
		>
			<p>© {year} Radio Ministerial Mushuk Kawsay. Todos los derechos reservados.</p>
			<p>Hecho con fe en Ecuador</p>
		</div>
	</div>
</footer>
