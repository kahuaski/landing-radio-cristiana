---
import Icon from "../atoms/Icon.astro";

const frequencies = [
	{ city: "Quito", dial: "98.7 FM", type: "FM" },
	{ city: "Guayaquil", dial: "104.3 FM", type: "FM" },
	{ city: "Cuenca", dial: "1520 AM", type: "AM" },
	{ city: "Todo el país", dial: "En línea", type: "Web" },
];
---

<section
	id="escuchanos"
	aria-labelledby="escuchanos-title"
	class="scroll-mt-20 bg-primary-container py-16 text-inverse-on-surface md:py-24 dark:bg-navy"
>
	<div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
		<div class="flex flex-col items-start gap-5">
			<span
				class="flex h-14 w-14 items-center justify-center rounded-lg bg-dawn-bright/15 text-dawn-bright"
			>
				<Icon name="radio" class="h-7 w-7" />
			</span>
			<h2
				id="escuchanos-title"
				class="font-display text-headline-lg font-bold tracking-tight text-white"
			>
				Escúchanos donde quiera que estés
			</h2>
			<p class="max-w-xl text-body-lg text-inverse-on-surface/75">
				Sintonízanos en la frecuencia de tu ciudad o disfruta de nuestra señal en
				línea desde cualquier dispositivo, sin interrupciones.
			</p>
			<button
				type="button"
				data-playlist-open
				class="inline-flex items-center gap-2 rounded-md bg-dawn px-5 py-3 text-label-lg font-semibold text-white transition-colors hover:bg-dawn-strong focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-dawn-bright focus-visible:ring-offset-2 focus-visible:ring-offset-primary-container"
			>
				<Icon name="play" class="h-5 w-5" />
				Reproducir ahora
			</button>
		</div>

		<ul class="grid gap-4 sm:grid-cols-2">
			{
				frequencies.map((freq) => (
					<li class="flex items-center justify-between gap-4 rounded-lg border border-white/10 bg-white/5 p-5 backdrop-blur">
						<div>
							<p class="text-label-md uppercase text-dawn-bright">{freq.city}</p>
							<p class="mt-1 font-display text-headline-md font-bold text-white">
								{freq.dial}
							</p>
						</div>
						<span
							class={`rounded-full px-3 py-1 text-label-broadcast uppercase ${
								freq.type === "Web"
									? "bg-dawn-bright text-navy"
									: "bg-white/10 text-white"
							}`}
						>
							{freq.type}
						</span>
					</li>
				))
			}
		</ul>
	</div>
</section>
