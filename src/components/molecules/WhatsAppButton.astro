---
import Icon from "../atoms/Icon.astro";

interface Props {
	/** Número en formato local de Ecuador (Ej: 0967198899). */
	numero?: string;
	/** Mensaje pre-escrito al abrir el chat. */
	mensaje?: string;
	/** Posición vertical (por defecto, encima del reproductor sticky). */
	class?: string;
}

const {
	numero = "0967198899",
	mensaje = "Hola, quiero información sobre Radio Ministerial Mushuk Kawsay.",
	class: className = "bottom-24",
} = Astro.props;

const digitos = numero.replace(/\D/g, "");
const internacionacional = digitos.startsWith("0")
	? `593${digitos.slice(1)}`
	: digitos;
const href = `https://wa.me/${internacionacional}?text=${encodeURIComponent(mensaje)}`;
---

<a
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	aria-label="Escríbenos por WhatsApp al 0967 1988 99"
	class={`group fixed end-4 z-40 inline-flex items-center gap-3 rounded-full bg-white p-1.5 pe-4 shadow-lg ring-1 ring-black/5 transition-transform hover:scale-105 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#25D366] focus-visible:ring-offset-2 focus-visible:ring-offset-surface dark:bg-navy-soft dark:ring-white/10 dark:focus-visible:ring-offset-navy ${className}`}
>
	<span
		class="hidden text-label-lg font-semibold text-[#075E54] dark:text-[#25D366] sm:inline"
	>
		Chatea con nosotros
	</span>
	<span
		class="flex h-12 w-12 items-center justify-center rounded-full bg-[#25D366] text-white shadow-[0_0_16px_2px_rgba(37,211,102,0.45)] transition-colors group-hover:bg-[#128C7E]"
	>
		<Icon name="whatsapp" class="h-6 w-6" />
	</span>
</a>
